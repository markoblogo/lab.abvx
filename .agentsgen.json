{
  "version": 1,
  "mode": "safe",
  "on_missing_markers": "write_generated",
  "generated_suffix": ".generated",
  "markers": {
    "start": "<!-- AGENTSGEN:START section={section} -->",
    "end": "<!-- AGENTSGEN:END section={section} -->"
  },
  "sections": [
    "guardrails",
    "workflow",
    "style",
    "agentsgen_contract",
    "task_contract",
    "verification",
    "stack",
    "repo_context"
  ],
  "presets": {},
  "defaults": {},
  "project": {
    "name": "ABVX Lab",
    "primary_stack": "static",
    "repo_root": "."
  },
  "paths": {
    "docs": [
      "README.md",
      "docs/index.html",
      "docs/tools/"
    ],
    "scripts": "scripts",
    "source_dirs": [
      "docs"
    ],
    "config_locations": [
      "docs/robots.txt",
      "docs/sitemap.xml"
    ]
  },
  "commands": {
    "install": "(not needed)",
    "dev": "python3 -m http.server 8000 --directory docs",
    "build": "python3 -m compileall -q scripts",
    "test": "python3 -m unittest discover -s tests -v",
    "lint": "python3 scripts/verify_site.py"
  },
  "evidence": {
    "python": [
      "scripts/verify_site.py",
      "tests/test_verify_site.py"
    ],
    "node": [],
    "make": [],
    "ci": [
      ".github/workflows/ci.yml"
    ]
  },
  "pack": {
    "enabled": true,
    "llms_format": "txt",
    "output_dir": "docs/ai",
    "files": [
      "docs/ai/task-contract.json"
    ]
  }
}
